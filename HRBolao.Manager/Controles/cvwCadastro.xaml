<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HRBolao.Manager.Controles.cvwCadastro">
    <Grid Opacity="0.95" BackgroundColor="#FFC0C0C0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Grid.ColumnSpan="3"
                Stroke="#FF606060" BackgroundColor="#FFEAEAEA"/>
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Cadastro: Novo Jogador" FontSize="16" FontAttributes="Bold"
                   Padding="8,8,8,8"
                   TextColor="White" BackgroundColor="{StaticResource gcorHRFundo}" />

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    BackgroundColor="Red"/>

            <Label Grid.Row="3" Grid.Column="1" Text="Empresa:" 
                   VerticalTextAlignment="Center"/>
            <Border Grid.Row="4" Grid.Column="1" Stroke="#FF303030" BackgroundColor="White">
                <Picker x:Name="pckEmpresa" 
                        ItemsSource="{Binding Path=ListaEmpresas}"
                        SelectedItem="{Binding Path=EmpresaSelecionada}"
                        ItemDisplayBinding="{Binding Path=NomeEmpresa}"
                        FontAttributes="Bold"
                        Margin="6,2,6,2"/>
            </Border>

            <Label Grid.Row="6" Grid.Column="1" Text="Nome/Apelido:" 
                   VerticalTextAlignment="Center"/>
            <Border Grid.Row="7" Grid.Column="1" Stroke="#FF303030" BackgroundColor="White">
                <Entry x:Name="entNomeApelido" 
                       MaxLength="100" Text="{Binding Path=JogadorLogin.NomeApelido}"
                       Margin="6,2,6,2"/>
            </Border>

            <Label Grid.Row="9" Grid.Column="1" Text="e-mail:"
                   VerticalTextAlignment="Center"/>
            <Border Grid.Row="10" Grid.Column="1" Stroke="#FF303030" BackgroundColor="White">
                <Entry x:Name="entEmail" 
                       MaxLength="100" Text="{Binding Path=JogadorLogin.email}"
                       Margin="6,2,6,2"/>
            </Border>

            <Label Grid.Row="12" Grid.Column="1" Text="Senha:"
                   VerticalTextAlignment="Center"/>
            <Border Grid.Row="13" Grid.Column="1" Stroke="#FF303030" BackgroundColor="White"
                    WidthRequest="120" HorizontalOptions="Start">
                <Entry x:Name="entSenha" MaxLength="10"
                       Text="{Binding Path=JogadorLogin.Senha}"
                       Margin="6,2,6,2"/>
            </Border>

            <Grid Grid.Row="15" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnVoltar" Grid.Row="0" Grid.Column="1"
                        CornerRadius="5" HorizontalOptions="End" Text="Voltar"
                        Clicked="btnVoltar_Clicked"/>
                <Button x:Name="btnGravar" Grid.Row="0" Grid.Column="3"
                        CornerRadius="5" HorizontalOptions="End" Text="Gravar"
                        Clicked="btnGravar_Clicked"/>
            </Grid>
        </Grid>
    </Grid>
</ContentView>